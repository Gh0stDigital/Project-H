{
  "name": "projectthoth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-placeholders.mjs && node scripts/gen-asset-manifest.mjs && tsc -b && vite build && node scripts/bundle-offline.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gen:assets": "node scripts/gen-placeholders.mjs && node scripts/gen-asset-manifest.mjs",
    "postinstall": "node scripts/gen-placeholders.mjs && node scripts/gen-asset-manifest.mjs"
  },
  "dependencies": {
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
